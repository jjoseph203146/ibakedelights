# Event/custom-order inquiry form email delivery (see lib/email.ts).
# Uses Resend (https://resend.com). Without these set, the form's API route
# fails loudly with a clear error instead of silently discarding inquiries.

# Resend API key.
RESEND_API_KEY=

# Verified "from" address in your Resend account/domain (e.g. inquiries@ibakedelights.com).
INQUIRY_FROM_EMAIL=

# Inbox that should receive inquiries. Defaults to the bakery's public email
# (ibakedelights@yahoo.com) if unset — set this to override.
INQUIRY_TO_EMAIL=
